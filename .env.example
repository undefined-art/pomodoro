# Docker Compose environment variables

# Required JWT / session secrets — MUST be strong random values in production.
# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=change-me-in-production
REFRESH_TOKEN_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production

# Database connection string used by the server container.
DATABASE_URL=file:/app/prisma/dev.db

# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:5173
