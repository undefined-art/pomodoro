{
  "name": "tempo-pomodoro",
  "version": "1.0.0",
  "description": "A modern Pomodoro timer application built with SolidJS and NestJS",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run start:dev",
    "dev:client": "cd client && pnpm dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && pnpm build",
    "start": "cd server && npm run start:prod",
    "install:all": "npm install && cd server && npm install && cd ../client && pnpm install",
    "db:generate": "cd server && npx prisma generate",
    "db:migrate": "cd server && npx prisma migrate dev",
    "db:seed": "cd server && npx prisma db seed",
    "db:studio": "cd server && npx prisma studio",
    "test": "npm run test:server",
    "test:server": "cd server && npm run test",
    "test:cov": "cd server && npm run test:cov",
    "lint": "cd server && npm run lint",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "setup": "npm run install:all && npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "pomodoro",
    "timer",
    "productivity",
    "solidjs",
    "nestjs",
    "typescript",
    "postgresql"
  ],
  "author": "undefined-art",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/undefined-art/pomodoro.git"
  },
  "bugs": {
    "url": "https://github.com/undefined-art/pomodoro/issues"
  },
  "homepage": "https://github.com/undefined-art/pomodoro#readme"
} 